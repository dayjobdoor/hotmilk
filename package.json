    "@oxlint/plugins": "^1.87.0",
    "@types/node": "^26.6.4",
    "@types/semver": "^7.8.0",
    "oxlint": "^1.87.0",
    "semver": "^7.8.5",
    "typebox": "^1.3.36",
    "vite-plus": "^1.1.0"
