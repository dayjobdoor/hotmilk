{
  "name": "hotmilk",
  "version": "0.1.4",
  "description": "hotmilk — Pi package bundling gentle-pi, context-mode, graphify, subagents, and bundled extension toggles via hotmilk.json",
  "keywords": [
    "hotmilk",
    "pi",
    "pi-package"
  ],
  "homepage": "https://github.com/dayjobdoor/hotmilk#readme",
  "bugs": {
    "url": "https://github.com/dayjobdoor/hotmilk/issues"
  },
  "license": "MIT",
  "author": "dayjobdoor <dayjobdoor@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dayjobdoor/hotmilk.git"
  },
  "files": [
    "src",
    "prompts",
    "skills",
    "themes",
    "mcp.json",
    "hotmilk.json",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "dashboard:start": "pi-dashboard start",
    "dashboard:stop": "pi-dashboard stop",
    "dashboard:status": "pi-dashboard status",
    "lint": "vp lint",
    "format": "vp fmt --write",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
